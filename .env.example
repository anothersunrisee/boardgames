# ─── PartyHub Indonesia Firebase Realtime Configuration ───────────────────────
# Dapatkan kredensial ini gratis di: https://console.firebase.google.com/
# 1. Buat Project Baru (contoh: partyhub-live)
# 2. Buka "Build" -> "Realtime Database" -> "Create Database" (Pilih region Singapore/asia-southeast1)
# 3. Masuk ke Project Settings -> Web App -> Salin konfigurasi di bawah:

VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
